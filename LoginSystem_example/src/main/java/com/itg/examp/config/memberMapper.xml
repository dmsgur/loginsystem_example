<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="memberMapper">
	<insert id="signup" parameterType="memb">
		INSERT INTO member (id,mid,mpw,name<if test='age != 0'>,age</if><if test='address != null and address !=""'>,address</if>) 
			VALUES (null,#{mid},password(#{mpw}),#{name}<if test='age != 0'>,#{age}</if><if test='address != null and address!=""'>,#{address}</if>)
	</insert>
	<select id="memberinfo" parameterType="string" resultType="memb">
		SELECT mid,name,age,address FROM member where mid=#{mid};
	</select>
	<select id="memberList" resultType="memb">
		SELECT mid,name,age,address FROM member;
	</select>
	<select id="memberlogin" parameterType="Map" resultType="memb">
		SELECT mid,name,age,address FROM member where mid=#{mid} and mpw=password(#{mpw});
	</select>
</mapper>